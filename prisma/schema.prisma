// اسکیمای دیتابیس مدیاجت.
// اصول ارشامان: کیف پول double-entry، audit trail، پول به ریال (BigInt).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  mobile    String   @unique
  name      String?
  role      Role     @default(user)
  createdAt DateTime @default(now())

  wallet   Wallet?
  orders   Order[]
  sessions Session[]
  payments Payment[]
}

enum Role {
  user
  operator
}

// کد یک‌بارمصرف احراز هویت با موبایل. کد هرگز خام ذخیره نمی‌شود، فقط هش آن.
model OtpCode {
  id        String    @id @default(cuid())
  mobile    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([mobile])
}

// نشست ورود کاربر. توکن خام فقط در کوکی کلاینت است؛ در دیتابیس فقط هش آن ذخیره می‌شود.
model Session {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Wallet {
  id          String  @id @default(cuid())
  userId      String  @unique
  balanceRial BigInt  @default(0) // موجودی به ریال؛ هرگز مستقیم دستکاری نشود
  user        User    @relation(fields: [userId], references: [id])

  transactions WalletTransaction[]
}

// هر تراکنش یک طرفِ ثبت‌شده از یک رویداد مالی است (double-entry ساده‌شده).
// balanceAfter برای auditability ذخیره می‌شود.
// immutable: فقط insert می‌شود؛ هیچ update/delete در منطق سرویس مجاز نیست.
model WalletTransaction {
  id              String   @id @default(cuid())
  walletId        String
  type            TxType
  amountRial      BigInt // همیشه مثبت؛ جهت با type مشخص می‌شود
  balanceAfter    BigInt
  ref             String? // مرجع: شناسه‌ی سفارش، شناسه‌ی درگاه و...
  idempotencyKey  String?  @unique // کلید یکتای درخواست پرداخت؛ از ساخت تراکنش تکراری جلوگیری می‌کند
  note            String?
  createdAt       DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
}

enum TxType {
  credit // شارژ / بازگشت وجه
  debit // پرداخت سفارش
}

// یک تلاش برای شارژ کیف پول از طریق درگاه پرداخت (فعلاً MockGateway، بعداً زرین‌پال).
// authority شناسه‌ی یکتای درگاه برای این تلاش پرداخت است.
// idempotencyKey برای جلوگیری از شارژ تکراری در صورت فراخوانی مکرر callback به creditWallet داده می‌شود.
model Payment {
  id             String        @id @default(cuid())
  userId         String
  amountRial     BigInt
  status         PaymentStatus @default(initiated)
  authority      String        @unique
  refId          String?
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum PaymentStatus {
  initiated
  paid
  failed
  verified
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  sourceSite     String
  category       String
  productUrl     String
  priceRial      BigInt
  status         OrderStatus @default(draft)
  idempotencyKey String?     @unique // کلید یکتای درخواست ثبت سفارش؛ از ساخت سفارش تکراری جلوگیری می‌کند
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  events   OrderEvent[]
  delivery Delivery?

  @@index([userId])
  @@index([status])
}

enum OrderStatus {
  draft
  awaiting_payment
  queued
  processing
  ready
  delivered
  cancelled
  failed
  refunded
}

// audit trail: هر تغییر وضعیت سفارش این‌جا ثبت می‌شود.
// immutable: فقط insert می‌شود؛ هیچ update/delete در منطق سرویس مجاز نیست.
model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  fromStatus String?
  toStatus   String
  actor      String // "user:<id>" یا "operator:<id>" یا "system"
  note       String?
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Delivery {
  id          String   @id @default(cuid())
  orderId     String   @unique
  fileUrl     String
  deliveredAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}
