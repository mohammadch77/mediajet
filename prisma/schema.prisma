// اسکیمای دیتابیس گت‌استوک.
// اصول ارشامان: کیف پول double-entry، audit trail، پول به ریال (BigInt).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  mobile    String   @unique
  // ورود بدون پیامک: هر دو اختیاری‌اند تا کاربرانی که فقط با OTP ثبت‌نام کرده‌اند قفل نشوند.
  // email همیشه lowercase ذخیره می‌شود؛ passwordHash فقط هش bcrypt است.
  email             String?   @unique
  passwordHash      String?
  passwordUpdatedAt DateTime?
  name      String?
  // پذیرش قوانین هنگام ثبت‌نام (کاربران قدیمی‌تر null هستند: قبل از این قابلیت ثبت‌نام کرده‌اند).
  termsAcceptedAt DateTime?
  termsVersion    String?
  role      Role     @default(user)
  createdAt DateTime @default(now())
  // غیرفعال‌سازی توسط ادمین: کاربر غیرفعال نمی‌تواند وارد شود و نشست‌هایش باطل می‌شود، ولی سابقه‌ی مالی/سفارش‌هایش دست‌نخورده می‌ماند.
  disabledAt     DateTime?
  disabledReason String?

  wallet          Wallet?
  orders          Order[]
  cart            Cart?
  sessions        Session[]
  payments        Payment[]
  supportMessages SupportMessage[]
  notifications   Notification[]
  passwordResets  PasswordReset[]

  // همکاری در فروش: کد یکتا فقط بعد از ثبت‌نام در برنامه ساخته می‌شود.
  // referredById فقط یک‌بار، لحظه‌ی ساخت کاربر، از کوکی ?ref= پر می‌شود و بعد از آن هرگز تغییر نمی‌کند.
  referralCode      String?   @unique
  affiliateJoinedAt DateTime?
  // تعلیق همکار توسط ادمین: لینکش دیگر زیرمجموعه ثبت نمی‌کند، کمیسیون جدید نمی‌گیرد و تسویه نمی‌تواند بدهد.
  affiliateSuspendedAt     DateTime?
  affiliateSuspendReason   String?
  // برای تشخیص تقلب همکاری: IP لحظه‌ی ثبت‌نام و آخرین ورود (فقط وقتی TRUST_PROXY درست تنظیم شده معتبر است).
  signupIp    String?
  lastLoginIp String?
  referredById      String?
  referredBy        User?     @relation("Referral", fields: [referredById], references: [id])
  referrals         User[]    @relation("Referral")
  affiliateAccount  AffiliateAccount?
  affiliatePayouts  AffiliatePayout[] @relation("PayoutOwner")
  payoutsReviewed   AffiliatePayout[] @relation("PayoutReviewer")
  affiliateLogsAbout AffiliateAdminLog[] @relation("AffiliateLogTarget")
  affiliateLogsMade  AffiliateAdminLog[] @relation("AffiliateLogActor")
  pendingCommissions AffiliatePendingCommission[]
  fraudFlags         AffiliateFraudFlag[] @relation("FraudFlagAffiliate")
  fraudFlagsResolved AffiliateFraudFlag[] @relation("FraudFlagResolver")

  roleChangesReceived RoleChangeLog[] @relation("RoleChangeTarget")
  roleChangesMade     RoleChangeLog[] @relation("RoleChangeActor")
  blogPosts           BlogPost[]

  @@index([referredById])
}

// لاگ append-only از تغییرات نقش کاربر توسط ادمین (چه کسی، چه زمانی، از چه نقشی به چه نقشی).
// immutable: فقط insert می‌شود.
model RoleChangeLog {
  id           String   @id @default(cuid())
  targetUserId String
  fromRole     Role
  toRole       Role
  changedById  String
  createdAt    DateTime @default(now())

  targetUser User @relation("RoleChangeTarget", fields: [targetUserId], references: [id])
  changedBy  User @relation("RoleChangeActor", fields: [changedById], references: [id])

  @@index([targetUserId])
}

enum Role {
  user
  operator
  admin
}

// کد یک‌بارمصرف احراز هویت با موبایل. کد هرگز خام ذخیره نمی‌شود، فقط هش آن.
model OtpCode {
  id        String    @id @default(cuid())
  mobile    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([mobile])
}

// درخواست بازیابی رمز: هم توکن لینک و هم کد پیامکی فقط به‌صورت هش SHA-256 ذخیره می‌شوند؛
// یک‌بارمصرف (usedAt)، منقضی‌شونده، و درخواست جدید درخواست‌های قبلی را باطل می‌کند.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// نشست ورود کاربر. توکن خام فقط در کوکی کلاینت است؛ در دیتابیس فقط هش آن ذخیره می‌شود.
model Session {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Wallet {
  id          String  @id @default(cuid())
  userId      String  @unique
  balanceRial BigInt  @default(0) // موجودی به ریال؛ هرگز مستقیم دستکاری نشود
  user        User    @relation(fields: [userId], references: [id])

  transactions WalletTransaction[]
}

// هر تراکنش یک طرفِ ثبت‌شده از یک رویداد مالی است (double-entry ساده‌شده).
// balanceAfter برای auditability ذخیره می‌شود.
// immutable: فقط insert می‌شود؛ هیچ update/delete در منطق سرویس مجاز نیست.
model WalletTransaction {
  id              String   @id @default(cuid())
  walletId        String
  type            TxType
  amountRial      BigInt // همیشه مثبت؛ جهت با type مشخص می‌شود
  balanceAfter    BigInt
  ref             String? // مرجع: شناسه‌ی سفارش، شناسه‌ی درگاه و...
  idempotencyKey  String?  @unique // کلید یکتای درخواست پرداخت؛ از ساخت تراکنش تکراری جلوگیری می‌کند
  note            String?
  createdAt       DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
}

enum TxType {
  credit // شارژ / بازگشت وجه
  debit // پرداخت سفارش
}

// یک تلاش برای شارژ کیف پول از طریق درگاه پرداخت (فعلاً MockGateway، بعداً زرین‌پال).
// authority شناسه‌ی یکتای درگاه برای این تلاش پرداخت است.
// idempotencyKey برای جلوگیری از شارژ تکراری در صورت فراخوانی مکرر callback به creditWallet داده می‌شود.
// orderId فقط برای پرداخت مستقیم سفارش از درگاه پر می‌شود (پرداخت شارژ کیف پول null است).
// یک سفارش می‌تواند چند تلاش پرداخت داشته باشد؛ فقط یک تلاش در حالت initiated باز می‌ماند
// (تلاش جدید، قبلی‌ها را failed می‌کند) و confirmOrderPayment با قفل سفارش جلوی صف‌شدن دوباره را می‌گیرد.
model Payment {
  id             String        @id @default(cuid())
  userId         String
  orderId        String?
  amountRial     BigInt
  status         PaymentStatus @default(initiated)
  authority      String        @unique
  refId          String?
  // آدرس هدایت به صفحه‌ی پرداخت درگاه؛ ذخیره می‌شود تا در درخواست تکراری (idempotent)
  // بتوان کاربر را به همان تلاش پرداخت قبلی برگرداند، بدون ساخت تلاش جدید.
  redirectUrl    String?
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([orderId])
}

enum PaymentStatus {
  initiated
  paid
  failed
  verified
}

model Order {
  id             String      @id @default(cuid())
  // شماره‌ی کوتاه و خوانا برای نمایش به کاربر/اپراتور (MJ-1001)؛ id همچنان کلید داخلی است.
  orderNumber    Int         @unique @default(autoincrement())
  userId         String
  totalPriceRial BigInt // مجموع priceRial همه‌ی آیتم‌ها به‌علاوه‌ی کارمزد روش پرداخت؛ فقط سمت سرور محاسبه می‌شود
  paymentMethod  String // "wallet" یا "gateway"؛ نوع lib/pricing.ts#PaymentMethod
  status         OrderStatus @default(draft)
  idempotencyKey String?     @unique // کلید یکتای درخواست ثبت سفارش؛ از ساخت سفارش تکراری جلوگیری می‌کند
  // true فقط برای سفارش‌هایی که از تسویه‌ی سبد خرید ساخته شده‌اند؛ به confirmOrderPayment
  // می‌گوید بعد از موفقیت پرداخت درگاهی، سبد همان کاربر را خالی کند (سفارش‌های تکی از این
  // مسیر عبور نمی‌کنند، پس سبد نامرتبطشان نباید پاک شود).
  cartCheckout   Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user    User         @relation(fields: [userId], references: [id])
  events  OrderEvent[]
  items   OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
}

// یک آیتم سفارش: یک محصول از یک سایت مبدأ با قیمت پایه‌ی خودش.
// وضعیت تحویل این آیتم مستقل از بقیه‌ی آیتم‌های همان سفارش است؛ کاربر هر آیتمِ آماده را
// می‌تواند زودتر دانلود کند. وضعیت کلی سفارش از وضعیت آیتم‌ها در lib/orderState.ts محاسبه می‌شود.
model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  sourceSite String
  category   String
  productUrl String
  priceRial  BigInt // قیمت پایه‌ی همین آیتم (پیش از کارمزد روش پرداخت که روی کل سفارش اعمال می‌شود)
  // جایگاه ۰-پایه‌ی آیتم در سفارش. «آیتم N» در تلگرام و پنل‌ها = position N-1. createdAt برای این کار
  // قابل اعتماد نیست چون آیتم‌های یک سفارش در یک دستور و با زمان یکسان ساخته می‌شوند.
  position   Int             @default(0)
  status     OrderItemStatus @default(pending)
  // «دسته‌ی اشتباه»: وقتی اپراتور موقع دانلود می‌بیند دسته‌ی ثبت‌شده درست نبوده، یا دسته اصلاح می‌شود
  // (قیمت بیشتر نمی‌شود) یا آیتم rejected و سهم آن به کیف پول برمی‌گردد؛ برای ممیزی و آمار دقت تشخیص.
  refundedRial BigInt    @default(0)
  mismatchFrom String?
  mismatchTo   String?
  mismatchById String?
  mismatchAt   DateTime?
  mismatchNote String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  order    Order     @relation(fields: [orderId], references: [id])
  delivery Delivery?

  @@unique([orderId, position])
  @@index([orderId])
}

enum OrderItemStatus {
  pending // در صف / در حال پردازش
  ready // فایل آماده‌ی دانلود است
  delivered // کاربر دانلود کرده یا اپراتور تحویل را نهایی کرده
  rejected // دسته‌ی اشتباه ثبت شده بود؛ سهم این آیتم به کیف پول برگشت و آیتم لغو شد
}

enum OrderStatus {
  draft
  awaiting_payment
  queued
  processing
  ready
  delivered
  cancelled
  failed
  refunded
}

// audit trail: هر تغییر وضعیت سفارش این‌جا ثبت می‌شود.
// immutable: فقط insert می‌شود؛ هیچ update/delete در منطق سرویس مجاز نیست.
model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  fromStatus String?
  toStatus   String
  actor      String // "user:<id>" یا "operator:<id>" یا "system"
  note       String?
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

// تحویل فایل سفارش به دو روش ممکن است ثبت شود:
// ۱) fileUrl: لینک دستی که اپراتور مستقیماً وارد می‌کند (روش قدیمی).
// ۲) storageKey: فایلی که از طریق بات تلگرام دریافت و در storage ذخیره شده (روش جدید).
// وقتی isLarge=true باشد، هیچ فایلی ذخیره نشده و پنل کاربر پیام پشتیبانی نشان می‌دهد.
model Delivery {
  id             String   @id @default(cuid())
  orderItemId    String   @unique
  fileUrl        String?
  storageKey     String?
  fileName       String?
  mimeType       String?
  fileSizeBytes  Int?
  isLarge        Boolean  @default(false)
  telegramFileId String?
  isOnDisk       Boolean  @default(false)
  lastAccessedAt DateTime?
  deliveredAt    DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
}

// سبد خرید کاربر پیش از ثبت سفارش. هر کاربرِ لاگین‌کرده حداکثر یک سبد باز دارد،
// پس با بستن مرورگر یا تعویض دستگاه از بین نمی‌رود. سبد مهمان (کاربر لاگین‌نکرده)
// در این قدم پیاده‌سازی نمی‌شود؛ پیش از افزودن آیتم باید لاگین کند.
model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]
}

// priceRial این‌جا فقط کش نمایشی قیمت لحظه‌ی افزودن به سبد است؛ در لحظه‌ی ثبت سفارش
// قیمت واقعی دوباره سمت سرور با lib/pricing.ts محاسبه می‌شود و مبنای پرداخت همان است.
model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  sourceSite String
  category   String
  productUrl String
  priceRial  BigInt
  createdAt  DateTime @default(now())

  cart Cart @relation(fields: [cartId], references: [id])

  @@index([cartId])
}

// پیام صندوق پشتیبانی دوطرفه: کاربر فقط از پنل کاربری، پشتیبانی فقط از تلگرام.
// append-only: فقط insert و آپدیت readByUser مجاز است؛ متن پیام هرگز ویرایش نمی‌شود.
model SupportMessage {
  id         String              @id @default(cuid())
  userId     String
  sender     SupportMessageSender
  text       String
  readByUser Boolean             @default(false)
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// اعلان‌های کاربر (زنگوله‌ی هدر): آماده شدن فایل، پاسخ پشتیبانی و ...
model Notification {
  id        String    @id @default(cuid())
  userId    String
  text      String
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

enum SupportMessageSender {
  user
  support
}

// تنظیمات حساس سیستم (کلید درگاه پرداخت، کلید پنل پیامک و مشابه).
// valueEncrypted همیشه رمزنگاری‌شده (AES-256-GCM) است؛ مقدار خام هرگز در دیتابیس ذخیره نمی‌شود.
model AppSetting {
  key            String   @id
  valueEncrypted String
  updatedAt      DateTime @updatedAt
  updatedBy      String
}

// محتوای ساختاریافته‌ی سایت (متن هیرو، تماس با ما، فوتر، منوی هدر و مشابه).
// غیرحساس است، پس برخلاف AppSetting رمزنگاری نمی‌شود. اگر کلیدی تنظیم نشده باشد،
// مقدار پیش‌فرض همان متن فعلی کد است (lib/content.ts) تا سایت هیچ‌وقت خالی نشود.
model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String
}

// صفحات متن‌آزاد سایت (درباره ما، قوانین و مقررات، سؤالات متداول و مشابه).
// contentHtml همیشه پیش از ذخیره sanitize می‌شود (lib/sanitize.ts) تا امکان
// تزریق اسکریپت مخرب از سمت ادمین یا حساب هک‌شده وجود نداشته باشد.
// published=false یعنی پیش‌نویس: در سایت عمومی ۴۰۴ برمی‌گردد.
model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  contentHtml     String
  published       Boolean  @default(false)
  metaTitle       String?
  metaDescription String?
  updatedAt       DateTime @updatedAt
  updatedBy       String
}

// نوشته‌های وبلاگ. همان الگوی Page: contentHtml همیشه پیش از ذخیره sanitize می‌شود
// (lib/sanitize.ts) و دوباره در رندر عمومی. published=false یعنی پیش‌نویس: در سایت عمومی ۴۰۴.
// publishedAt زمان اولین انتشار را نگه می‌دارد (برای نمایش تاریخ در لیست عمومی و مرتب‌سازی).
model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?
  contentHtml     String
  coverImage      String?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  authorId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([published, publishedAt])
}

// ---------------------------------------------------------------------------
// همکاری در فروش (افیلیت)
// ---------------------------------------------------------------------------

// موجودی کمیسیون همکار؛ جدا از کیف پول خرید، چون این پول قابل برداشت نقدی است.
// balanceRial هرگز مستقیم دستکاری نشود؛ فقط از طریق lib/affiliate.ts با ثبت ردیف در AffiliateLedger.
model AffiliateAccount {
  id          String @id @default(cuid())
  userId      String @unique
  balanceRial BigInt @default(0)

  user    User              @relation(fields: [userId], references: [id])
  entries AffiliateLedger[]
}

// دفتر کمیسیون: append-only، هر ردیف با balanceAfter.
// idempotencyKey یکتا تضمین می‌کند که هر سفارش حداکثر یک‌بار کمیسیون بسازد.
model AffiliateLedger {
  id             String              @id @default(cuid())
  accountId      String
  type           AffiliateEntryType
  amountRial     BigInt // همیشه مثبت؛ جهت با type مشخص می‌شود
  balanceAfter   BigInt
  orderId        String?
  payoutId       String?
  sourceUserId   String? // زیرمجموعه‌ای که پرداختش این کمیسیون را ساخت
  baseRial       BigInt? // مبنای محاسبه‌ی کمیسیون (قیمت پایه‌ی آیتم‌ها، بدون کارمزد روش پرداخت)
  percent        Int? // درصد کمیسیون در لحظه‌ی ثبت (تغییر بعدی تنظیمات روی این ردیف اثر ندارد)
  idempotencyKey String              @unique
  note           String?
  createdAt      DateTime            @default(now())

  account AffiliateAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
}

enum AffiliateEntryType {
  commission // کمیسیون خرید زیرمجموعه (افزایش)
  payout_hold // کسر موجودی هنگام ثبت درخواست تسویه (کاهش)
  payout_release // بازگشت موجودی وقتی درخواست تسویه رد شود (افزایش)
  commission_reversal // برگشت کمیسیون وقتی سفارش زیرمجموعه بازگشت وجه شود (کاهش؛ ممکن است موجودی را منفی کند)
  adjustment_credit // اصلاح دستی ادمین با دلیل (افزایش)
  adjustment_debit // اصلاح دستی ادمین با دلیل (کاهش؛ موجودی را منفی نمی‌کند)
}

// لاگ append-only اقدامات ادمین روی همکاری در فروش (تعلیق، فعال‌سازی، تغییر معرف، اصلاح موجودی).
// immutable: فقط insert می‌شود.
model AffiliateAdminLog {
  id           String   @id @default(cuid())
  targetUserId String
  actorId      String
  action       String // suspend | unsuspend | set_referrer | adjust_balance
  detail       String
  createdAt    DateTime @default(now())

  targetUser User @relation("AffiliateLogTarget", fields: [targetUserId], references: [id])
  actor      User @relation("AffiliateLogActor", fields: [actorId], references: [id])

  @@index([targetUserId])
}

// درخواست تسویه‌ی کارت‌به‌کارت. مبلغ در لحظه‌ی درخواست از موجودی کسر (hold) می‌شود تا
// نتوان یک موجودی را دوبار درخواست داد؛ رد درخواست آن را برمی‌گرداند، پرداخت آن را نهایی می‌کند.
model AffiliatePayout {
  id           String                @id @default(cuid())
  userId       String
  amountRial   BigInt
  cardNumber   String
  cardHolder   String
  status       AffiliatePayoutStatus @default(requested)
  adminNote    String?
  bankRef      String? // شماره پیگیری واریز
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime              @default(now())

  user       User  @relation("PayoutOwner", fields: [userId], references: [id])
  reviewedBy User? @relation("PayoutReviewer", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
}

enum AffiliatePayoutStatus {
  requested
  paid
  rejected
}

// کمیسیون در انتظار: بلافاصله بعد از پرداخت سفارش ساخته می‌شود ولی هنوز قابل برداشت نیست.
// وقتی سفارش تحویل شد (یا «آماده» ماند و دوره‌ی انتظار گذشت) آزاد می‌شود و ردیف commission در
// AffiliateLedger می‌سازد. اگر پیش از آزادسازی بازگشت وجه شود، لغو می‌شود و هیچ پولی جابه‌جا نمی‌شود.
model AffiliatePendingCommission {
  id           String                  @id @default(cuid())
  orderId      String                  @unique
  affiliateId  String
  sourceUserId String
  baseRial     BigInt
  percent      Int
  amountRial   BigInt
  status       PendingCommissionStatus @default(pending)
  createdAt    DateTime                @default(now())
  resolvedAt   DateTime?

  affiliate User @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId, status])
  @@index([status, createdAt])
}

enum PendingCommissionStatus {
  pending
  released
  cancelled
}

// هشدار خودکار تقلب همکاری در فروش. append-only به‌جز فیلدهای resolve (بررسی ادمین).
model AffiliateFraudFlag {
  id           String    @id @default(cuid())
  affiliateId  String
  kind         String // same_ip | ip_burst | shared_card
  detail       String
  dedupeKey    String    @unique // جلوگیری از هشدار تکراری برای یک رویداد
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolution   String?

  affiliate  User  @relation("FraudFlagAffiliate", fields: [affiliateId], references: [id])
  resolvedBy User? @relation("FraudFlagResolver", fields: [resolvedById], references: [id])

  @@index([affiliateId, resolvedAt])
  @@index([resolvedAt])
}

// ردّ حسابرسی ابزار توسعه‌ی پنل ادمین (/admin/ide): هر باز/قفل، ذخیره، حذف، بازگردانی،
// آپلود/دانلود زیپ و deploy یک ردیف. فقط‌افزودنی است؛ هیچ update/delete در منطق سرویس مجاز نیست.
model IdeAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String // unlock | unlock_failed | save | create | delete | restore | zip_download | zip_apply | deploy | sync_push | sync_pull
  path      String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}

// لاگ خطاهای برنامه (کاربر و سرور) برای پنل ادمین (/admin/errors). خطاهای یکسان با fingerprint
// ادغام می‌شوند و فقط count/lastSeenAt بالا می‌رود تا یک باگِ پرتکرار هزاران ردیف نسازد.
// file/line/column «بهترین مکان شناخته‌شده»‌اند: با source map به کد اصلی (مثلاً components/X.tsx:12:3)
// برگردانده می‌شوند و اگر نشد، همان مکان خام باندل.
model ErrorLog {
  id             String    @id @default(cuid())
  fingerprint    String    @unique
  source         String // client | server
  kind           String // error | unhandledrejection | boundary | api | network | server
  message        String
  stack          String? // استک خام (کوتاه‌شده)
  resolvedStack  String? // استک با مسیر فایل‌های اصلی (از source map)
  componentStack String?
  file           String?
  line           Int?
  column         Int?
  functionName   String?
  locationMapped Boolean   @default(false) // آیا file/line از source map آمده؟
  url            String? // مسیر صفحه (بدون query)
  statusCode     Int?
  digest         String?
  userAgent      String?
  lastUserId     String?
  count          Int       @default(1)
  status         String    @default("open") // open | resolved
  resolvedAt     DateTime?
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())

  @@index([status, lastSeenAt])
  @@index([lastSeenAt])
}
