DATABASE_URL="postgresql://user:password@localhost:5432/mediajet?schema=public"

# کلید اصلی رمزنگاری تنظیمات حساس (lib/crypto.ts) — ۳۲ بایت به‌صورت hex (۶۴ کاراکتر).
# با این دستور یک کلید جدید بساز: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_FINANCE=
TELEGRAM_CHAT_OPERATOR=
TELEGRAM_CHAT_SUPPORT=
TELEGRAM_WEBHOOK_SECRET=

# رله‌ی تلگرام برای سرور داخل ایران (Cloudflare Worker در پوشه‌ی telegram-relay/).
# خالی = اتصال مستقیم به https://api.telegram.org (توسعه‌ی محلی). مقدار پنل ادمین بر این‌ها اولویت دارد.
TELEGRAM_API_BASE=
# همان RELAY_SECRET که در Worker با wrangler secret put ست شده؛ در هدر X-Relay-Secret فرستاده می‌شود.
TELEGRAM_RELAY_SECRET=

# آدرس عمومی سایت برای لینک بازیابی رمز (مثلاً https://mediajet.ir). هرگز از هدر Host درخواست خوانده نمی‌شود.
# در production اگر خالی باشد، بازیابی فقط با کد انجام می‌شود.
APP_BASE_URL=
# روش پیامک بازیابی رمز: code | link | both (از پنل ادمین هم قابل تنظیم است و آن مقدم است).
PASSWORD_RESET_SMS_MODE=code
# فقط وقتی سرور پشت پروکسی خودمان (nginx) است true شود تا IP واقعی از X-Forwarded-For برای rate limit خوانده شود.
TRUST_PROXY=false

# رمز endpointهای cron (/api/cron/*)؛ با هدر Authorization: Bearer <مقدار>. در production الزامی است.
# بساز: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ابزار توسعه‌ی پنل ادمین (/admin/ide): ویرایش کد، زیپ، deploy. پیش‌فرض خاموش است.
# چون دسترسی به کد یعنی کنترل کامل سرور، فقط از همین‌جا (نه از پنل) روشن می‌شود. ورود با رمز مجدد ادمین هم لازم است.
ADMIN_IDE_ENABLED=false
# ریشه‌ی پروژه برای ابزار توسعه (پیش‌فرض: پوشه‌ی اجرای برنامه).
IDE_ROOT=
# محل نسخه‌های پشتیبان فایل‌ها، لاگ deploy و زیپ‌های موقت؛ بیرون از ریشه‌ی پروژه (پیش‌فرض /var/backups/getstock-ide).
IDE_BACKUP_DIR=
# نام فرایند pm2 برای ری‌استارت بعد از deploy (پیش‌فرض getstock).
IDE_PM2_NAME=
