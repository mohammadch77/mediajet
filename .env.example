DATABASE_URL="postgresql://user:password@localhost:5432/mediajet?schema=public"

# کلید اصلی رمزنگاری تنظیمات حساس (lib/crypto.ts) — ۳۲ بایت به‌صورت hex (۶۴ کاراکتر).
# با این دستور یک کلید جدید بساز: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_FINANCE=
TELEGRAM_CHAT_OPERATOR=
TELEGRAM_CHAT_SUPPORT=
TELEGRAM_WEBHOOK_SECRET=

# آدرس عمومی سایت برای لینک بازیابی رمز (مثلاً https://mediajet.ir). هرگز از هدر Host درخواست خوانده نمی‌شود.
# در production اگر خالی باشد، بازیابی فقط با کد انجام می‌شود.
APP_BASE_URL=
# روش پیامک بازیابی رمز: code | link | both (از پنل ادمین هم قابل تنظیم است و آن مقدم است).
PASSWORD_RESET_SMS_MODE=code
# فقط وقتی سرور پشت پروکسی خودمان (nginx) است true شود تا IP واقعی از X-Forwarded-For برای rate limit خوانده شود.
TRUST_PROXY=false
